<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest-recommended</AnalysisLevel>

        <AssemblyName>BluetoothHandsFreeToggle</AssemblyName>
        <RootNamespace>BluetoothHandsFreeToggle</RootNamespace>
        <Version>2.0.0</Version>
        <Description>Soft reset and hard disable/restore modes for Windows Bluetooth Hands-Free services.</Description>
        <ApplicationManifest>app.manifest</ApplicationManifest>

        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
    </ItemGroup>

</Project>
