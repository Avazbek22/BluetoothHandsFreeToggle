<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest-recommended</AnalysisLevel>

        <AssemblyName>BluetoothHandsFreeToggle</AssemblyName>
        <RootNamespace>BluetoothHandsFreeToggle</RootNamespace>
        <Version>2.0.0</Version>
        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <FileVersion>2.0.0.0</FileVersion>
        <InformationalVersion>2</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Description>Soft reset and hard disable/restore modes for Windows Bluetooth Hands-Free services.</Description>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Docs\*.txt">
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Localization\Resources\*.json" />
    </ItemGroup>

</Project>
