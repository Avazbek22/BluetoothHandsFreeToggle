<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <!-- Required by the source-generated (trim- and AOT-safe) COM interop for Core Audio. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <AssemblyName>BluetoothHandsFreeToggle</AssemblyName>
        <RootNamespace>BluetoothHandsFreeToggle</RootNamespace>
        <Product>BluetoothHandsFreeToggle</Product>
        <Authors>Avazbek22</Authors>
        <Company>Olimoff Dev</Company>
        <Copyright>Copyright © 2026 Avazbek Olimov</Copyright>
        <Version>2.2.0</Version>
        <AssemblyVersion>2.2.0.0</AssemblyVersion>
        <FileVersion>2.2.0.0</FileVersion>
        <InformationalVersion>2.2</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Description>Fixes low-quality Windows Bluetooth headset audio with safe HFP reset, disable, and restore modes.</Description>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Docs\*.txt">
            <WithCulture>false</WithCulture>
        </EmbeddedResource>
        <EmbeddedResource Include="Localization\Resources\*.json" />
        <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="BluetoothHandsFreeToggle.AppIcon.ico" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BluetoothHandsFreeToggle.Tests" />
    </ItemGroup>

</Project>
