<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:BluetoothHandsFreeToggle.Gui.Controls">

    <Styles.Resources>
        <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="PanelBrush" Color="#1C1C1F" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#242428" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="RaisedBrush" Color="#2E2E33" />
        <SolidColorBrush x:Key="DividerBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#EDEDEF" />
        <SolidColorBrush x:Key="SubBrush" Color="#B4B4BB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#96969E" />
        <SolidColorBrush x:Key="PendingBrush" Color="#5E5E66" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E5484D" />
        <SolidColorBrush x:Key="AccentButtonBrush" Color="#CA3F44" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#EC767A" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EE5484D" />
        <SolidColorBrush x:Key="GreenBrush" Color="#3DD68C" />
        <SolidColorBrush x:Key="AmberBrush" Color="#F5B94A" />
        <SolidColorBrush x:Key="AmberSoftBrush" Color="#21F5B94A" />

        <!-- A borderless, transparent button that lights up on hover (header, footer, rows). -->
        <ControlTheme x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="#12FFFFFF" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="#0AFFFFFF" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#PART_Border">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.5" />
            </Style>
        </ControlTheme>

        <!-- The square 36 px icon button of the header (settings, back). -->
        <ControlTheme x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
        </ControlTheme>

        <!-- A full-width settings row: icon, label, chevron. -->
        <ControlTheme x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </ControlTheme>

        <!-- The large action button. Neutral by default; class "main" makes it the red call to action. -->
        <ControlTheme x:Key="FilledButton" TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="#1FFFFFFF" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="#0FFFFFFF" />
            </Style>
            <Style Selector="^.main">
                <Setter Property="Background" Value="{StaticResource AccentButtonBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style Selector="^.main:pointerover /template/ Border#PART_Border">
                <Setter Property="Background" Value="#DA444A" />
            </Style>
            <Style Selector="^.main:pressed /template/ Border#PART_Border">
                <Setter Property="Background" Value="#B5383D" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#PART_Border">
                <Setter Property="BorderBrush" Value="#99FFFFFF" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.5" />
            </Style>
        </ControlTheme>

        <!-- The small rounded button inside cards ("Change", "Copy report", language picker). -->
        <ControlTheme x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource FilledButton}">
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
        </ControlTheme>

        <!-- iOS-like switch: 44×24 rounded track, a white 20 px knob that glides across. -->
        <ControlTheme x:Key="{x:Type c:PillSwitch}" TargetType="c:PillSwitch">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#3A3A40" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_Focus"
                                Margin="-3"
                                CornerRadius="15"
                                BorderThickness="2"
                                BorderBrush="Transparent" />
                        <Border Name="PART_Track"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                        <Border Name="PART_Knob"
                                Width="20"
                                Height="20"
                                CornerRadius="10"
                                Background="White"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="2,0,0,0"
                                BoxShadow="0 1 3 0 #59000000">
                            <Border.Transitions>
                                <Transitions>
                                    <ThicknessTransition Property="Margin" Duration="0:0:0.2">
                                        <ThicknessTransition.Easing>
                                            <CubicEaseOut />
                                        </ThicknessTransition.Easing>
                                    </ThicknessTransition>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Track">
                <Setter Property="Background" Value="#44444B" />
            </Style>
            <Style Selector="^:checked /template/ Border#PART_Track">
                <Setter Property="Background" Value="{StaticResource AccentButtonBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style Selector="^:checked:pointerover /template/ Border#PART_Track">
                <Setter Property="Background" Value="#DA444A" />
            </Style>
            <Style Selector="^:checked /template/ Border#PART_Knob">
                <Setter Property="Margin" Value="22,0,0,0" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#PART_Focus">
                <Setter Property="BorderBrush" Value="#99FFFFFF" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.5" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!-- Font, size and colour come from the window and inherit, so buttons can recolour their text. -->

    <!-- 12/16 secondary line under a label. -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.caption.soft">
        <Setter Property="Foreground" Value="{StaticResource SubBrush}" />
    </Style>

    <!-- Section heading above a group of cards. -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.step.active">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.step.pending">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Background" Value="{StaticResource DividerBrush}" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="#2A2A2F" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Popups (language list): the same raised graphite surface as the panel. -->
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="#2A2A2F" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="ListBox.menu ListBoxItem">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ListBox.menu ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#14FFFFFF" />
    </Style>

    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="True" />
    </Style>
</Styles>
