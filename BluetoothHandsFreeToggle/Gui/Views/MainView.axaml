<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BluetoothHandsFreeToggle.Gui.ViewModels"
             xmlns:c="using:BluetoothHandsFreeToggle.Gui.Controls"
             x:Class="BluetoothHandsFreeToggle.Gui.Views.MainView"
             x:DataType="vm:FlyoutViewModel">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer Grid.Row="0" Margin="0,0,-14,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12" Margin="0,0,14,0">

                <!-- Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" Height="36">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                        <c:StrokeIcon Data="{x:Static c:Icons.Headphones}" Size="17" Foreground="{StaticResource AccentTextBrush}" />
                    </Border>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="{Binding L.AppTitle}" FontWeight="SemiBold" />
                    <Button Grid.Column="2" Name="SettingsButton" Theme="{StaticResource IconButton}"
                            Command="{Binding ShowSettingsCommand}"
                            ToolTip.Tip="{Binding L.Settings}"
                            AutomationProperties.Name="{Binding L.Settings}">
                        <c:StrokeIcon Data="{x:Static c:Icons.Settings}" Size="18" StrokeThickness="1.8" />
                    </Button>
                </Grid>

                <!-- Device -->
                <Border Classes="card" Padding="12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource RaisedBrush}">
                            <c:StrokeIcon Data="{x:Static c:Icons.Headphones}" Size="19" StrokeThickness="1.8"
                                          Foreground="{StaticResource TextBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Name="DeviceTitle" Text="{Binding DeviceTitle}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="caption" Text="{Binding DeviceSubtitle}" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding DeviceSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <Border Grid.Column="2" IsVisible="{Binding HasChip}" Height="24" CornerRadius="12" Padding="10,0"
                                VerticalAlignment="Center" Background="{Binding ChipBackground}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{Binding ChipForeground}"
                                        VerticalAlignment="Center" />
                                <TextBlock Name="ChipText" Text="{Binding ChipText}" Foreground="{Binding ChipForeground}"
                                           FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Ring, title, action -->
                <StackPanel Spacing="10" Margin="0,4,0,0">
                    <Panel Width="148" Height="148" HorizontalAlignment="Center">
                        <c:ProgressRing Name="Ring" Value="{Binding RingValue}" RingBrush="{Binding RingBrush}" Thickness="8" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
                            <c:StrokeIcon Data="{Binding RingIcon}" IsVisible="{Binding HasRingIcon}" Size="26"
                                          Foreground="{Binding RingIconBrush}" HorizontalAlignment="Center" />
                            <TextBlock Name="CenterText" Text="{Binding CenterText}" FontSize="{Binding CenterFontSize}"
                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                       IsVisible="{Binding CenterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="caption" Text="{Binding CenterSubtitle}" HorizontalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       IsVisible="{Binding CenterSubtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Panel>

                    <StackPanel Spacing="2" Margin="8,0">
                        <TextBlock Name="StateTitle" Classes="display" Text="{Binding Title}" FontSize="18" LineHeight="24"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Name="StateDescription" Text="{Binding Description}" FontSize="13" LineHeight="18"
                                   MinHeight="36" Foreground="{StaticResource SubBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Name="PrimaryButton" Theme="{StaticResource FilledButton}" HorizontalAlignment="Stretch"
                            Classes.main="{Binding PrimaryIsMain}"
                            IsVisible="{Binding HasPrimary}"
                            Command="{Binding PrimaryCommand}"
                            AutomationProperties.Name="{Binding PrimaryText}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <c:StrokeIcon Data="{x:Static c:Icons.Shield}" Size="16" IsVisible="{Binding PrimaryShowsShield}"
                                          VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border IsVisible="{Binding HasNotice}" CornerRadius="10" Padding="12,8"
                            Background="{StaticResource AmberSoftBrush}">
                        <TextBlock Name="NoticeText" Text="{Binding Notice}" FontSize="12" LineHeight="16"
                                   Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <!-- Hard mode -->
                <Border Classes="card" Padding="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="label" Text="{Binding L.HardTitle}" />
                                <c:StrokeIcon Data="{x:Static c:Icons.Shield}" Size="14" VerticalAlignment="Center"
                                              Foreground="{StaticResource MutedBrush}"
                                              ToolTip.Tip="{Binding L.AdminRequired}" />
                            </StackPanel>
                            <TextBlock Classes="caption" Text="{Binding L.HardDescription}" />
                        </StackPanel>
                        <c:PillSwitch Grid.Column="1" Name="HardSwitch" Margin="12,0,0,0" VerticalAlignment="Center"
                                      AutoToggle="False"
                                      IsChecked="{Binding HardSwitchOn, Mode=OneWay}"
                                      Command="{Binding ToggleHardCommand}"
                                      AutomationProperties.Name="{Binding L.HardTitle}" />
                    </Grid>
                </Border>

                <!-- Context: operation steps, microphone, or what happened -->
                <Border Classes="card" Padding="12">
                    <Panel>
                        <StackPanel Spacing="10" IsVisible="{Binding IsStepsContext}">
                            <TextBlock Classes="section" Text="{Binding L.StepsTitle}" />
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StepItem">
                                        <Grid ColumnDefinitions="18,*" ColumnSpacing="10">
                                            <Panel Height="20" VerticalAlignment="Top">
                                                <c:StrokeIcon Data="{x:Static c:Icons.Check}" Size="16" StrokeThickness="2.6"
                                                              Foreground="{StaticResource GreenBrush}"
                                                              IsVisible="{Binding IsDone}" />
                                                <Panel IsVisible="{Binding IsActive}">
                                                    <Border Width="16" Height="16" CornerRadius="8"
                                                            Background="{StaticResource AccentSoftBrush}" />
                                                    <Border Width="8" Height="8" CornerRadius="4"
                                                            Background="{StaticResource AccentBrush}" />
                                                </Panel>
                                                <Border Width="8" Height="8" CornerRadius="4" BorderThickness="1.5"
                                                        BorderBrush="{StaticResource PendingBrush}"
                                                        IsVisible="{Binding IsPending}" />
                                            </Panel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Classes="step" Classes.active="{Binding IsActive}"
                                                           Classes.pending="{Binding IsPending}"
                                                           Text="{Binding Title}" TextWrapping="Wrap" />
                                                <TextBlock Classes="caption soft" Text="{Binding Detail}"
                                                           IsVisible="{Binding IsActive}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Spacing="10" IsVisible="{Binding IsMicContext}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <c:StrokeIcon Data="{Binding MicIcon}" Size="16" StrokeThickness="1.9"
                                              Foreground="{Binding MicIconBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="label" Text="{Binding L.MicTitle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Name="MicStatus" Text="{Binding MicStatusText}"
                                           Foreground="{Binding MicStatusBrush}" FontSize="12" FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MicApps}" IsVisible="{Binding HasMicApps}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppItem">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource RaisedBrush}">
                                                <TextBlock Text="{Binding Initial}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="label" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="caption"
                                                           Text="{Binding $parent[ItemsControl].((vm:FlyoutViewModel)DataContext).L.MicRecording}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Name="MicDescription" Classes="caption soft" Text="{Binding MicDescription}"
                                       IsVisible="{Binding HasMicDescription}" />

                            <Border IsVisible="{Binding ShowDefaultMicrophone}" BorderThickness="0,1,0,0"
                                    BorderBrush="{StaticResource DividerBrush}" Padding="0,8,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Classes="caption soft" Text="{Binding L.MicDefault}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Theme="{StaticResource PillButton}"
                                            Content="{Binding L.Change}"
                                            Command="{Binding OpenSoundSettingsCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsInfoContext}">
                            <TextBlock Text="{Binding InfoTitle}" Foreground="{Binding InfoTitleBrush}"
                                       FontSize="12" LineHeight="16" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding InfoLines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="13" LineHeight="18"
                                                   Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Theme="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,2,0,0"
                                    IsVisible="{Binding CanCopyReport}"
                                    Command="{Binding CopyReportCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:StrokeIcon Data="{x:Static c:Icons.Copy}" Size="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CopyReportText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Panel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Text="{Binding L.Version}" />
                <Button Grid.Column="2" Name="HelpButton" Theme="{StaticResource GhostButton}"
                        Content="{Binding L.Help}" Command="{Binding ShowHelpCommand}" />
                <Button Grid.Column="3" Theme="{StaticResource GhostButton}" Command="{Binding OpenSupportCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <c:StrokeIcon Data="{x:Static c:Icons.Heart}" Size="14" Foreground="{StaticResource AccentTextBrush}"
                                      VerticalAlignment="Center" />
                        <TextBlock Text="{Binding L.Support}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
