<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <!-- Required by the source-generated (trim- and AOT-safe) COM interop for Core Audio. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <AssemblyName>StereoKeeper</AssemblyName>
        <RootNamespace>StereoKeeper</RootNamespace>
        <Product>StereoKeeper</Product>
        <Authors>Avazbek22</Authors>
        <Company>Olimoff Dev</Company>
        <Copyright>Copyright © 2026 Avazbek Olimov</Copyright>
        <Version>3.0.0</Version>
        <AssemblyVersion>3.0.0.0</AssemblyVersion>
        <FileVersion>3.0.0.0</FileVersion>
        <InformationalVersion>3.0</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <Description>Tray app that fixes muffled, mono Bluetooth headphone audio on Windows by bringing stereo back from call mode (HFP).</Description>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\Resources\*.json" />
        <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="StereoKeeper.AppIcon.ico" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="StereoKeeper.Tests" />
    </ItemGroup>

</Project>
