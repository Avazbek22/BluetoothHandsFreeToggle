<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:StereoKeeper.Gui.ViewModels"
        xmlns:views="using:StereoKeeper.Gui.Views"
        x:Class="StereoKeeper.Gui.FlyoutWindow"
        x:DataType="vm:FlyoutViewModel"
        Title="StereoKeeper"
        Width="400" Height="800"
        WindowDecorations="None"
        CanResize="False"
        CanMinimize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        FontFamily="{StaticResource TextFont}"
        FontSize="14"
        Foreground="{StaticResource TextBrush}">

    <!-- The transparent margin holds the shadow; a click there closes the panel like a click outside. -->
    <Panel Name="Root" Background="Transparent">
        <Border Name="Card"
                Margin="20"
                CornerRadius="12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                BoxShadow="0 12 32 0 #73000000, 0 2 8 0 #40000000">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <Border CornerRadius="11" ClipToBounds="True">
                <Panel>
                    <views:MainView Name="MainPage" IsVisible="{Binding IsMainPage}" />
                    <views:SettingsView Name="SettingsPage" IsVisible="{Binding IsSettingsPage}" />
                    <views:HelpView Name="HelpPage" IsVisible="{Binding IsHelpPage}" />
                </Panel>
            </Border>
        </Border>
    </Panel>
</Window>
